rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cotizaciones/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /productos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
